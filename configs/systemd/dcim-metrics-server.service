[Unit]
Description=DCIM Pipeline Prometheus Metrics Server
After=network.target

[Service]
Type=simple
User=infra
Group=infra
WorkingDirectory=/home/infra/dcim_metrics_project
Environment="PYTHONPATH=/home/infra/dcim_metrics_project"
ExecStart=/usr/bin/python3 src/observability/metrics_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
